# Signs customer and manager session cookies (and NextAuth). Required in
# production; generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Paystack (https://dashboard.paystack.com). Optional locally; payments
# won't process without them.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"

# WebAuthn / passkeys: must match the URL in the browser
NEXT_PUBLIC_RP_ID="localhost"
NEXT_PUBLIC_RP_NAME="Aim-Hye Integrated Concepts"
NEXT_PUBLIC_ORIGIN="http://localhost:3000"

# Canonical site URL used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- Hosting (Vercel + Turso). Leave these unset for local development (uses prisma/dev.db) ----
# Turso database URL and token: https://turso.tech (free tier). See DEPLOY.md.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# "true" on the public portfolio demo: shows a demo banner and displays login codes on screen
# (no SMS provider is connected). NEVER set this on a real business site.
DEMO_MODE="false"

# Passwords for the accounts the seed creates (otherwise random ones are generated and printed)
SEED_ADMIN_PASSWORD=""
SEED_MANAGER_PASSWORD=""
